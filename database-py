import sqlite3
from sqlite3 import Connection, Cursor

class Database:
    _instance = None
    _db_path = "clinica.db"

    def __new__(cls):
        if cls._instance is None:
            cls._instance = super(Database,cls).__new__(cls)
        return cls._instance
    def get_connection(self)-> Connection:
        conn = sqlite3.connect(self._db_path)
        conn.row_factory = sqlite3.Row               #Esta linea es para acceder a las columnas por nombre
        return conn 

    #el self es para un objeto ya creado
    #el cls es la clase que se usara para crear el objeto

    def init(self)-> None:
    #Ingresar las tablas necesarias en la base de datos
        conn = self.get_connection()
        try:
            cursor = conn.cursor()

        #Tabla de departamento
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS pacientes (
                    id_departamento INTEGER PRIMARY KEY AUTOINCREMENT,
                    nombre TEXT NOT NULL,
                    piso INTEGER NOT NULL
                )
            """)

        #Tabla paciente
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS departamentos (
                    rut INTEGER PRIMARY KEY AUTOINCREMENT,
                    nombre TEXT NOT NULL,
                    edad INTEGER NOT NULL,
                    prevision TEXT NOT NULL,
                    id_departamento INTEGER,
                    FOREIGN KEY (id_departamento) REFERENCES pacientes(id_departamento) ON DELETE SET NULL
                )
            """)
            conn.commit()
        except sqlite3.Error as e:
            print(f"Error al inicializar la base de datos: {e}")
        finally:
            conn.close()

if __name__ == "__main__":
    db = Database()
    db.init()
    print("Base de datos inicializada correctamente.")